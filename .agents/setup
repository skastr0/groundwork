#!/usr/bin/env bash
set -euo pipefail

BUN_VERSION="1.3.14"
AST_GREP_VERSION="0.43.0"
SEMGREP_VERSION="1.159.0"

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
export PATH="$BUN_INSTALL/bin:$HOME/.local/bin:$PATH"

locate_orb_setup() {
  local candidate
  for candidate in \
    "${repo_root}/../repos/orb-setup" \
    "${repo_root}/../repos/skastr0/orb-setup" \
    "${repo_root}/../orb-setup"; do
    if [[ -x "${candidate}/bin/setup.sh" ]]; then
      printf '%s' "$(cd "$candidate" && pwd)"
      return 0
    fi
  done
  return 1
}

step() {
  local name="$1"
  shift
  echo "==> $name"
  local start
  start="$(date +%s)"
  "$@"
  echo "==> $name done in $(($(date +%s) - start))s"
}

persist_tool_paths() {
  local marker="# groundwork toolchain PATH"
  local profile="$HOME/.bash_profile"
  touch "$profile"
  if grep -Fqx "$marker" "$profile" 2>/dev/null; then
    return
  fi
  cat >> "$profile" <<EOF

$marker
export BUN_INSTALL="\$HOME/.bun"
if [ -d "\$BUN_INSTALL/bin" ]; then
  case ":\$PATH:" in
    *":\$BUN_INSTALL/bin:"*) ;;
    *) export PATH="\$BUN_INSTALL/bin:\$PATH" ;;
  esac
fi
if [ -d "\$HOME/.local/bin" ]; then
  case ":\$PATH:" in
    *":\$HOME/.local/bin:"*) ;;
    *) export PATH="\$HOME/.local/bin:\$PATH" ;;
  esac
fi
EOF
}

install_bun() {
  local declared
  declared="$(sed -n 's/.*"packageManager": *"bun@\([^"]*\)".*/\1/p' package.json)"
  if [[ "$declared" != "$BUN_VERSION" ]]; then
    printf '[setup] error: package.json pins bun@%s, setup expects %s\n' "$declared" "$BUN_VERSION" >&2
    exit 1
  fi
  if command -v bun >/dev/null 2>&1 && [[ "$(bun --version)" == "$BUN_VERSION" ]]; then
    echo "bun $BUN_VERSION already installed ($(command -v bun))"
    return
  fi
  curl -fsSL https://bun.sh/install | bash -s -- "bun-v${BUN_VERSION}"
  export PATH="$BUN_INSTALL/bin:$PATH"
  if [[ "$(bun --version)" != "$BUN_VERSION" ]]; then
    printf '[setup] error: expected Bun %s, found %s\n' "$BUN_VERSION" "$(bun --version)" >&2
    exit 1
  fi
}

install_deps() {
  bun install --frozen-lockfile
}

ast_grep_ok() {
  command -v sg >/dev/null 2>&1 || return 1
  sg --version 2>/dev/null | grep -Fq "$AST_GREP_VERSION"
}

install_ast_grep() {
  if ast_grep_ok; then
    echo "ast-grep $AST_GREP_VERSION already installed ($(command -v sg))"
    return
  fi
  npm install -g --prefix "$HOME/.local" "@ast-grep/cli@${AST_GREP_VERSION}"
  if ! ast_grep_ok; then
    printf '[setup] error: ast-grep %s is not available as sg\n' "$AST_GREP_VERSION" >&2
    exit 1
  fi
}

semgrep_ok() {
  command -v semgrep >/dev/null 2>&1 || return 1
  semgrep --version 2>/dev/null | grep -Fq "$SEMGREP_VERSION"
}

install_semgrep() {
  if semgrep_ok; then
    echo "semgrep $SEMGREP_VERSION already installed ($(command -v semgrep))"
    return
  fi
  python3 -m pip install --user "semgrep==${SEMGREP_VERSION}"
  export PATH="$HOME/.local/bin:$PATH"
  if ! semgrep_ok; then
    printf '[setup] error: semgrep %s is not available\n' "$SEMGREP_VERSION" >&2
    exit 1
  fi
}

orb_setup="$(locate_orb_setup)" || {
  printf '[setup] error: orb-setup checkout not found next to this repository\n' >&2
  exit 1
}
printf '[setup] Using shared runtime at %s\n' "$orb_setup"
bash "${orb_setup}/bin/setup.sh"
export PATH="$BUN_INSTALL/bin:$HOME/.local/bin:$PATH"

step "persist toolchain PATH" persist_tool_paths
step "install bun ${BUN_VERSION}" install_bun
step "install JS dependencies" install_deps
step "install ast-grep ${AST_GREP_VERSION}" install_ast_grep
step "install semgrep ${SEMGREP_VERSION}" install_semgrep

echo "==> setup complete"
echo "bun=$(command -v bun) $(bun --version)"
echo "sg=$(command -v sg) $(sg --version 2>/dev/null | head -n 1)"
echo "semgrep=$(command -v semgrep) $(semgrep --version 2>/dev/null | head -n 1)"
