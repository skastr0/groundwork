#!/usr/bin/env bash
set -euo pipefail

BUN_VERSION="1.3.14"
AST_GREP_VERSION="0.43.0"
SEMGREP_VERSION="1.159.0"
QUASAR_VERSION="0.5.3"

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
export PATH="$BUN_INSTALL/bin:$HOME/.local/bin:$PATH"

step() {
  local name="$1"
  shift
  echo "==> $name"
  local start
  start="$(date +%s)"
  "$@"
  echo "==> $name done in $(($(date +%s) - start))s"
}

persist_tool_paths() {
  local marker="# groundwork toolchain PATH"
  local profile="$HOME/.bash_profile"
  touch "$profile"
  if ! grep -Fqx "$marker" "$profile" 2>/dev/null; then
    cat >> "$profile" <<EOF

$marker
export BUN_INSTALL="\$HOME/.bun"
if [ -d "\$BUN_INSTALL/bin" ]; then
  case ":\$PATH:" in
    *":\$BUN_INSTALL/bin:"*) ;;
    *) export PATH="\$BUN_INSTALL/bin:\$PATH" ;;
  esac
fi
if [ -d "\$HOME/.local/bin" ]; then
  case ":\$PATH:" in
    *":\$HOME/.local/bin:"*) ;;
    *) export PATH="\$HOME/.local/bin:\$PATH" ;;
  esac
fi
EOF
  fi
}

install_bun() {
  if command -v bun >/dev/null 2>&1 && [[ "$(bun --version)" == "$BUN_VERSION" ]]; then
    echo "bun $BUN_VERSION already installed ($(command -v bun))"
    return
  fi
  curl -fsSL https://bun.sh/install | bash -s -- "bun-v${BUN_VERSION}"
  export PATH="$BUN_INSTALL/bin:$PATH"
  bun --version
}

install_deps() {
  bun install --frozen-lockfile
}

ast_grep_ok() {
  command -v sg >/dev/null 2>&1 || return 1
  sg --version 2>/dev/null | grep -Fq "$AST_GREP_VERSION"
}

install_ast_grep() {
  if ast_grep_ok; then
    echo "ast-grep $AST_GREP_VERSION already installed ($(command -v sg))"
    return
  fi
  npm install -g --prefix "$HOME/.local" "@ast-grep/cli@${AST_GREP_VERSION}"
  sg --version
}

semgrep_ok() {
  command -v semgrep >/dev/null 2>&1 || return 1
  semgrep --version 2>/dev/null | grep -Fq "$SEMGREP_VERSION"
}

install_semgrep() {
  if semgrep_ok; then
    echo "semgrep $SEMGREP_VERSION already installed ($(command -v semgrep))"
    return
  fi
  python3 -m pip install --user "semgrep==${SEMGREP_VERSION}"
  semgrep --version
}

install_tailscale() {
  sudo install -d /etc/systemd/system/tailscaled.service.d
  sudo tee /etc/systemd/system/tailscaled.service.d/amp-orb.conf >/dev/null <<'EOF'
[Service]
Environment=TS_ASSUME_NETWORK_UP_FOR_TEST=true
EOF
  if ! command -v tailscale >/dev/null 2>&1; then
    curl -fsSL https://tailscale.com/install.sh | sh
  else
    echo "tailscale already installed ($(command -v tailscale))"
  fi
  sudo systemctl daemon-reload
  # Start a stopped daemon; do not restart an already-running one.
  sudo systemctl enable --now tailscaled
}

install_quasar() {
  local quasar_package="$HOME/.local/lib/node_modules/@skastr0/quasar-cli/package.json"
  local installed
  installed="$(node -p 'require(process.argv[1]).version' "$quasar_package" 2>/dev/null || true)"
  if [[ -x "$HOME/.local/bin/quasar" && "$installed" == "$QUASAR_VERSION" ]]; then
    echo "quasar $QUASAR_VERSION already installed ($HOME/.local/bin/quasar)"
    return
  fi
  npm install --global --prefix "$HOME/.local" "@skastr0/quasar-cli@${QUASAR_VERSION}"
}

step "persist toolchain PATH" persist_tool_paths
step "install bun ${BUN_VERSION}" install_bun
step "install JS dependencies" install_deps
step "install ast-grep ${AST_GREP_VERSION}" install_ast_grep
step "install semgrep ${SEMGREP_VERSION}" install_semgrep
step "install Tailscale" install_tailscale
step "install quasar-cli ${QUASAR_VERSION}" install_quasar

echo "==> setup complete"
echo "bun=$(command -v bun) $(bun --version)"
echo "sg=$(command -v sg) $(sg --version 2>/dev/null | head -n 1)"
echo "semgrep=$(command -v semgrep) $(semgrep --version 2>/dev/null | head -n 1)"
echo "tailscale=$(command -v tailscale)"
echo "quasar=$(command -v quasar)"
