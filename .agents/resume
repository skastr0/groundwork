#!/usr/bin/env bash
# Never trace the short-lived workload identity, even when invoked with bash -x.
set +x
set -euo pipefail

export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
export PATH="$BUN_INSTALL/bin:$HOME/.local/bin:$PATH"

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

locate_orb_setup() {
  local candidate
  for candidate in \
    "${repo_root}/../repos/orb-setup" \
    "${repo_root}/../repos/skastr0/orb-setup" \
    "${repo_root}/../orb-setup"; do
    if [[ -x "${candidate}/bin/resume.sh" ]]; then
      printf '%s' "$(cd "$candidate" && pwd)"
      return 0
    fi
  done
  return 1
}

missing=0
for cmd in bun sg semgrep; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "resume: missing $cmd" >&2
    missing=1
  fi
done

if [[ "$missing" -ne 0 ]]; then
  echo "resume: run .agents/setup" >&2
  exit 1
fi

if [[ "$(sg --version 2>/dev/null | head -n 1)" == *"Usage:"* ]] || ! sg --version >/dev/null 2>&1; then
  echo "resume: sg is not ast-grep (shadowed by $(command -v sg))" >&2
  exit 1
fi

if ! semgrep --version >/dev/null 2>&1; then
  echo "resume: semgrep is not usable ($(command -v semgrep))" >&2
  exit 1
fi

orb_setup="$(locate_orb_setup)" || {
  printf '[resume] error: orb-setup checkout not found next to this repository\n' >&2
  exit 1
}
bash "${orb_setup}/bin/resume.sh"
printf 'resume: bun=%s sg=%s semgrep=%s\n' \
  "$(command -v bun)" "$(command -v sg)" "$(command -v semgrep)"
