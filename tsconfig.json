{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "@skastr0/groundwork-core": ["./packages/core/src/index.ts"],
      "@skastr0/groundwork-core/*": ["./packages/core/src/*"]
    },
    "types": ["bun", "node"]
  },
  "include": ["src/**/*.ts", "packages/**/*.ts", "review/**/*.ts"],
  "exclude": ["node_modules", "prism-plugin"]
}
