{
  "name": "groundwork",
  "version": "0.1.0",
  "description": "Groundwork policy, provenance, context, and risk foundations for agentic development tools",
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "groundwork": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js",
    "./cli": "./dist/cli.js"
  },
  "files": [
    ".codex-plugin",
    "docs",
    "dist",
    "hooks",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:cli",
    "build:js": "bun build ./src/server.ts ./src/cli.ts --outdir ./dist --target bun --format esm --external @opencode-ai/plugin",
    "build:cli": "bun scripts/build-cli.ts",
    "install:local": "bun scripts/install.ts",
    "check:imports": "bun -e \"await import('./dist/server.js')\"",
    "check:cli": "bun ./dist/cli.js doctor",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run test && bun run build && bun run check:imports && bun run check:cli"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "codex",
    "codex-plugin",
    "groundwork",
    "context",
    "risk",
    "framework",
    "provenance",
    "policy"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.3.17"
  },
  "dependencies": {
    "@effect/cli": "^0.75.1",
    "@effect/platform-bun": "^0.89.0",
    "@iarna/toml": "^2.2.5",
    "effect": "^3.19.19",
    "gray-matter": "^4.0.3",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.3.17",
    "@opencode-ai/sdk": "1.3.17",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "opencode": ">=1.3.17"
  }
}
