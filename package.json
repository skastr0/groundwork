{
  "name": "epistemology-framework",
  "version": "0.1.0",
  "description": "OpenCode epistemology framework plugin",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/server.ts --outdir ./dist --target bun --format esm --external @opencode-ai/plugin",
    "check:imports": "bun -e \"await import('./dist/server.js')\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run test && bun run build && bun run check:imports"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "epistemology",
    "provenance",
    "policy"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.3.17"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "effect": "^3.19.19",
    "gray-matter": "^4.0.3",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.3.17",
    "@opencode-ai/sdk": "1.3.17",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "opencode": ">=1.3.17"
  }
}
