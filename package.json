{
  "name": "@skastr0/groundwork",
  "version": "0.1.0",
  "description": "Groundwork policy, provenance, context, and risk foundations for agentic development tools",
  "type": "module",
  "author": "Guilherme Castro <skastr052@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/skastr0/groundwork#readme",
  "bugs": {
    "url": "https://github.com/skastr0/groundwork/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/groundwork.git"
  },
  "main": "./dist/server.js",
  "bin": {
    "groundwork": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js",
    "./metadata": "./dist/metadata.js",
    "./cli": "./dist/cli.js"
  },
  "files": [
    ".codex-plugin",
    "CHANGELOG.md",
    "docs",
    "dist/cli.js",
    "dist/metadata.js",
    "dist/server.js",
    "hooks",
    "README.md"
  ],
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:cli && bun run build:js",
    "build:js": "bun build ./src/server.ts ./src/cli.ts ./src/metadata.ts --outdir ./dist --target bun --format esm --external @opencode-ai/plugin",
    "build:cli": "bun scripts/build-cli.ts",
    "install:local": "bun scripts/install.ts",
    "check:imports": "bun -e \"await import('./dist/server.js')\"",
    "check:cli": "bun ./dist/cli.js doctor",
    "check:local-install": "bun scripts/check-local-install.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run test && bun run build && bun run check:imports && bun run check:cli && bun run check:local-install",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "codex",
    "codex-plugin",
    "groundwork",
    "context",
    "risk",
    "framework",
    "provenance",
    "policy"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.3.17"
  },
  "dependencies": {
    "@effect/cli": "^0.75.1",
    "@effect/platform-bun": "^0.89.0",
    "@iarna/toml": "^2.2.5",
    "effect": "^3.21.2",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.3.17",
    "@opencode-ai/sdk": "1.3.17",
    "@skastr0/pulsar-project-module-effect": "^0.1.1",
    "@skastr0/pulsar-project-module-sdk": "^0.1.1",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "opencode": ">=1.3.17"
  }
}
