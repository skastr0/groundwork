{
  "name": "@skastr0/groundwork",
  "version": "0.2.1",
  "description": "Groundwork policy, provenance, context, and risk foundations for agentic development tools",
  "type": "module",
  "author": "Guilherme Castro <skastr052@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/skastr0/groundwork#readme",
  "bugs": {
    "url": "https://github.com/skastr0/groundwork/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/groundwork.git"
  },
  "main": "./dist/cli.js",
  "bin": {
    "groundwork": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./metadata": "./dist/metadata.js",
    "./cli": "./dist/cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "docs",
    "dist/cli.js",
    "dist/metadata.js",
    "README.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:packages && bun run build:cli && bun run build:js",
    "build:packages": "bun run --cwd packages/core build",
    "build:js": "bun build ./src/cli.ts ./src/metadata.ts --outdir ./dist --target bun --format esm",
    "build:cli": "bun scripts/build-cli.ts",
    "install:local": "bun scripts/install.ts",
    "check:imports": "bun -e \"await import('./dist/cli.js'); await import('./dist/metadata.js'); await import('./packages/core/dist/index.js'); await import('./packages/core/dist/cli-support.js'); await import('./packages/core/dist/portable/index.js')\"",
    "check:cli": "bun ./dist/cli.js doctor",
    "check:local-install": "bun scripts/check-local-install.ts",
    "plugin:package": "bun scripts/package-harness-plugins.ts",
    "plugin:compile": "bun run plugin:package",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run test && bun run build && bun run check:imports && bun run check:cli && bun run check:local-install",
    "pack:dry-run": "npm pack --dry-run",
    "pack:dry-run:all": "bun run pack:dry-run && bun run --cwd packages/core pack:dry-run",
    "pack:install-smoke": "bun scripts/check-packed-installs.ts",
    "pack:verify": "bun run pack:dry-run:all && bun run pack:install-smoke"
  },
  "keywords": [
    "groundwork",
    "cli",
    "context",
    "risk",
    "framework",
    "provenance",
    "policy"
  ],
  "dependencies": {
    "@skastr0/groundwork-core": "0.2.1",
    "@effect/cli": "^0.75.1",
    "@effect/platform-bun": "^0.89.0",
    "effect": "^3.21.2",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.3.17",
    "@opencode-ai/sdk": "1.3.17",
    "@skastr0/pulsar-project-module-effect": "^0.1.1",
    "@skastr0/pulsar-project-module-sdk": "^0.1.1",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
