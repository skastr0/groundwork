{
  "name": "@skastr0/groundwork-opencode-plugin",
  "version": "0.2.0",
  "description": "OpenCode plugin wrapper for Groundwork foundations",
  "type": "module",
  "author": "Guilherme Castro <skastr052@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/skastr0/groundwork#readme",
  "bugs": {
    "url": "https://github.com/skastr0/groundwork/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/groundwork.git",
    "directory": "packages/opencode-plugin"
  },
  "main": "./dist/server.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/server.ts --root ./src --outdir ./dist --target bun --format esm --external @opencode-ai/plugin --external @skastr0/groundwork-core",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "groundwork",
    "opencode",
    "opencode-plugin",
    "policy",
    "context",
    "provenance",
    "risk"
  ],
  "dependencies": {
    "@skastr0/groundwork-core": "0.2.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.3.17"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.3.17"
  },
  "engines": {
    "opencode": ">=1.3.17"
  }
}
