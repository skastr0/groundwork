{
  "name": "@skastr0/groundwork-codex",
  "version": "0.2.1",
  "description": "Self-contained Groundwork Codex plugin hooks",
  "type": "module",
  "author": "Guilherme Castro <skastr052@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/skastr0/groundwork#readme",
  "bugs": {
    "url": "https://github.com/skastr0/groundwork/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/groundwork.git",
    "directory": "packages/codex"
  },
  "main": "./dist/groundwork-codex-hook.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/groundwork-codex-hook.mjs"
    }
  },
  "files": [
    ".codex-plugin",
    "dist",
    "hooks",
    "types",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/hook.ts --outfile ./dist/groundwork-codex-hook.mjs --target node --format esm --minify",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "groundwork",
    "codex",
    "codex-plugin",
    "hooks",
    "policy",
    "context",
    "provenance",
    "risk"
  ],
  "dependencies": {
    "@skastr0/groundwork-core": "0.2.1",
    "effect": "^3.21.2"
  },
  "engines": {
    "node": ">=24"
  }
}
